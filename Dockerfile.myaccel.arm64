FROM ubuntu:24.04

ARG LLVM_PROJECT_SHA=1053047a4be7d1fece3adaf5e7597f838058c947
ARG NPROC=8
ARG WORK_DIR=/workdir

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=${WORK_DIR}/onnx-mlir/build/Release/bin:${WORK_DIR}/llvm-project/build/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:${WORK_DIR}/onnx-mlir/build/Release/lib:${WORK_DIR}/llvm-project/build/lib

WORKDIR ${WORK_DIR}

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends \
      ca-certificates clang cmake curl g++ gcc git libncurses-dev \
      make ninja-build python3 python3-dev python3-pip python3-setuptools \
      python3-venv python3-wheel zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/llvm/llvm-project.git llvm-project && \
    cd llvm-project && \
    git checkout ${LLVM_PROJECT_SHA} && \
    cmake -S llvm -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DLLVM_ENABLE_PROJECTS=mlir \
      -DLLVM_TARGETS_TO_BUILD=AArch64 \
      -DLLVM_ENABLE_ASSERTIONS=ON \
      -DLLVM_ENABLE_RTTI=ON \
      -DLLVM_ENABLE_LIBEDIT=OFF \
      -DLLVM_ENABLE_TERMINFO=OFF \
      -DLLVM_ENABLE_ZLIB=ON \
      -DLLVM_ENABLE_ZSTD=OFF \
      -DBUILD_SHARED_LIBS=ON && \
    cmake --build build --parallel ${NPROC} && \
    cmake --install build && \
    ldconfig

COPY third_party/onnx-mlir ${WORK_DIR}/onnx-mlir

RUN cd onnx-mlir/third_party/onnx && \
    CC=clang CXX=clang++ CMAKE_ARGS="-DCMAKE_INSTALL_LIBDIR=lib" \
      python3 -m pip install --break-system-packages . --no-build-isolation && \
    cd ${WORK_DIR}/onnx-mlir && \
    cmake -S . -B build/Release -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DMLIR_DIR=${WORK_DIR}/llvm-project/build/lib/cmake/mlir \
      -DLLVM_DIR=${WORK_DIR}/llvm-project/build/lib/cmake/llvm \
      -DLLVM_ENABLE_ASSERTIONS=ON \
      -DCMAKE_INSTALL_MESSAGE=NEVER \
      -DONNX_MLIR_ACCELERATORS=MyAccel && \
    cmake --build build/Release --parallel ${NPROC} && \
    cmake --install build/Release && \
    ldconfig

ENTRYPOINT ["/bin/bash", "-lc"]
